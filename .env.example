# Copy this to .env and edit it:  cp .env.example .env
# Real environment variables win over anything in this file.

# Which backend the agents use by default: "ollama" (local) or "anthropic" (Claude API)
LLM_PROVIDER=ollama

# --- Claude API ---
# Only needed if some role uses the anthropic provider.
ANTHROPIC_API_KEY=
# Any Claude model id, e.g. claude-sonnet-5-5 (better) or claude-haiku-5-5 (cheaper)
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Pull it first: `ollama pull llama3` (mistral, qwen2.5, gemma3 etc. also work)
OLLAMA_MODEL=llama3
# Ollama's default context is often too small for the architect's prompt + answer.
OLLAMA_NUM_CTX=8192

# --- Different model per role (optional) ---
# Format is provider:model. Leave empty to use LLM_PROVIDER and its model.
# A common setup is to generate locally for free and judge with something stronger:
#   EVALUATOR_LLM=anthropic:claude-sonnet-5-5
ARCHITECT_LLM=
LOCALIZER_LLM=
EVALUATOR_LLM=

# Temperature per role. Leave a value empty to use the provider's default.
ARCHITECT_TEMPERATURE=0.7
LOCALIZER_TEMPERATURE=0.6
EVALUATOR_TEMPERATURE=0.0

# --- LLM calls ---
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=180
# Tries per call, for timeouts/rate limits and for output that doesn't fit the schema
LLM_MAX_ATTEMPTS=3

# --- Quality gate ---
# A sample is published when its score is at least this
QUALITY_THRESHOLD=0.85
# How many times the localizer gets to fix a rejected draft before we give up
MAX_RETRIES=3
# If any single rubric score is below this, the final score is capped at it
DIMENSION_FLOOR=0.6
# Share of the architect's key entities that must survive translation
MIN_ENTITY_COVERAGE=0.6

# --- Running ---
# Samples processed in parallel. 1-2 on a single local GPU, 4-8 with the API.
MAX_CONCURRENCY=2
OUTPUT_DIR=data

# --- Hugging Face (optional) ---
# Write token from https://huggingface.co/settings/tokens
HF_TOKEN=
# e.g. your-username/polyglot-medical-indic
HF_REPO_ID=
HF_PRIVATE=true
