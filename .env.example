# =============================================================================
# PolyGlot-Crew configuration. Copy to `.env` and edit:  cp .env.example .env
# Real environment variables take precedence over values in this file.
# =============================================================================

# ---- Backend selection ------------------------------------------------------
# Default provider for all agents: "ollama" (local) or "anthropic" (Claude API)
LLM_PROVIDER=ollama

# ---- Anthropic (Claude API) -------------------------------------------------
# Required only if any role uses the anthropic provider.
ANTHROPIC_API_KEY=
# Any Claude model id works, e.g. claude-sonnet-5-5 (quality) or claude-haiku-5-5 (cost)
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Ollama (local open-source models) --------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Must be pulled first: `ollama pull llama3` (or mistral, qwen2.5, gemma3, ...)
OLLAMA_MODEL=llama3
# Context window requested from Ollama. Its default is often too small for the
# architect prompt plus a multi-sub-topic response.
OLLAMA_NUM_CTX=8192

# ---- Per-role model routing (optional) --------------------------------------
# Format "provider:model". Unset roles use LLM_PROVIDER + its model above.
# Example: generate locally for free, but judge with a stronger model to reduce
# self-preference bias:
#   EVALUATOR_LLM=anthropic:claude-sonnet-5-5
ARCHITECT_LLM=
LOCALIZER_LLM=
EVALUATOR_LLM=

# Sampling temperature per role. Leave a value empty to use the provider default.
ARCHITECT_TEMPERATURE=0.7
LOCALIZER_TEMPERATURE=0.6
EVALUATOR_TEMPERATURE=0.0

# ---- LLM call behaviour ------------------------------------------------------
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=180
# Attempts per call for transient errors and schema-invalid output
LLM_MAX_ATTEMPTS=3

# ---- Quality gate ------------------------------------------------------------
# Export when quality_score >= QUALITY_THRESHOLD
QUALITY_THRESHOLD=0.85
# Re-generation rounds with critic feedback before a sample is quarantined
MAX_RETRIES=3
# Any rubric dimension below this caps the final score at that dimension
DIMENSION_FLOOR=0.6
# Share of the architect's key entities that must survive localization
MIN_ENTITY_COVERAGE=0.6

# ---- Execution & storage ----------------------------------------------------
# Parallel sample workers. Keep 1-2 for a single local GPU; 4-8 for the API.
MAX_CONCURRENCY=2
OUTPUT_DIR=data

# ---- Hugging Face Hub (optional) --------------------------------------------
# Write token from https://huggingface.co/settings/tokens
HF_TOKEN=
# e.g. your-username/polyglot-medical-indic
HF_REPO_ID=
HF_PRIVATE=true
